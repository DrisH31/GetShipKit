# Copy to .env.local and fill in. Never commit .env.local.
# The app builds without any of these; it needs them to run.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Clerk (auth) -------------------------------------------------------------
# dashboard.clerk.com → API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Clerk → Webhooks → your endpoint (/api/webhook/clerk) → Signing secret
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# --- Supabase (database) --------------------------------------------------------
# Supabase → Project Settings → API Keys. The new sb_publishable_/sb_secret_ keys
# are preferred; the legacy anon / service_role keys also work
# (NEXT_PUBLIC_SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only. Bypasses row-level security: never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# --- Polar (payments) -------------------------------------------------------------
# "sandbox" while testing (sandbox.polar.sh, its own token and webhook secret),
# "production" when you take real money.
POLAR_MODE=sandbox
POLAR_ACCESS_TOKEN=polar_oat_...
# Polar → Settings → Webhooks → your endpoint (/api/webhook/polar), API version 2026-10
POLAR_WEBHOOK_SECRET=whsec_...
POLAR_SUCCESS_URL=http://localhost:3000/dashboard/billing?success=true

# Payment model shown on the pricing page: "subscription" or "onetime"
NEXT_PUBLIC_PAYMENT_MODEL=subscription

# What paying customers see on /dashboard (server-only; sent only after the paywall check)
PAID_REPOSITORY_URL=
PAID_QUICK_START_URL=
PAID_DOCS_URL=
SOCIAL_URL=
WEBSITE_URL=

# Your Polar product ids, as "PRODUCT_ID:Display name"
NEXT_PUBLIC_PRODUCTS={"starter_monthly":"<polar-product-id>:Basic","starter_annual":"<polar-product-id>:Basic","pro_monthly":"<polar-product-id>:Premium","pro_annual":"<polar-product-id>:Premium","enterprise_monthly":"<polar-product-id>:Ultimate","enterprise_annual":"<polar-product-id>:Ultimate","one_time":"<polar-product-id>:Forever Access"}
